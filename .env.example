# Copy this file to ".env" and fill it in. NEVER commit .env.

APP_ENV=production            # use "local" while developing to see error details
APP_TIMEZONE=Asia/Kolkata
# Public URL of the app (used in password-reset emails). No trailing slash.
APP_URL=http://localhost/SmartCanteen

# --- Database (your old code used port 3307) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=smartcanteen
DB_USER=root
DB_PASS=

# --- Razorpay TEST mode (Dashboard > Account & Settings > API Keys, with "Test Mode" switched on) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if you set up the webhook (recommended for production). Any long random string you also paste in the dashboard.
RAZORPAY_WEBHOOK_SECRET=

# XAMPP on Windows only, if payments fail with "SSL certificate problem": download
# https://curl.se/ca/cacert.pem and point to it, e.g. C:/xampp/php/extras/ssl/cacert.pem
# CURL_CA_BUNDLE=

# --- Email (Gmail App Password; create NEW ones - the old ones were committed to the repo) ---
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Smart Canteen

# --- College rules (all optional) ---
# Prefix added to USNs that students type without it (e.g. 23IS056 -> 4GW23IS056)
USN_PREFIX=4GW
# Sign people out after this many idle minutes
SESSION_IDLE_MINUTES=120
# Accept orders only between these times (24h HH:MM, app timezone). Leave empty for always open.
CANTEEN_OPEN=
CANTEEN_CLOSE=
